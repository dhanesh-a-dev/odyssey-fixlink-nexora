# FixLink Environment Variables
# Copy to .env and replace with your PostgreSQL credentials

# Database: PostgreSQL connection string (Works with Neon, Vercel Postgres, Supabase, Railway, Docker, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fixlink?schema=public"

# Authentication: Secure JWT signing secret (min 32 chars)
JWT_SECRET="fixlink-super-secret-jwt-key-2026-secure-auth-32chars"

# Node Environment
NODE_ENV="development"
